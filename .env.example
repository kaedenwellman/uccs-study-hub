# Copy relevant values into Vercel Project Settings -> Environment Variables.
# VITE_* vars are needed at BUILD time (client). The rest are server-only.

# --- Client (build-time, safe to expose) ---
VITE_VAPID_PUBLIC_KEY=
VITE_APP_TOKEN=
# Optional; defaults to same-origin "/api"
VITE_API_BASE=

# --- Server (keep secret; set in Vercel only) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
APP_TOKEN=
CRON_SECRET=

# --- Storage: added automatically by the Vercel Upstash/KV integration ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
